# /etc/jsboard.env — readable by root only (mode 600). systemd reads it before
# dropping to the jsboard user, so the webhook never sits in a world-readable file.
AWS_DEFAULT_REGION=ap-northeast-1
JSBOARD_BUCKET=jsboard-capture
# Books recorded around the clock and replayed every morning.
JSBOARD_TARGETS=bitbank:ada_jpy,bitbank:sui_jpy
# Paste the Slack incoming-webhook URL after the = on the server itself.
SLACK_WEBHOOK_URL=
